=bcount |=([n=@ud i=@ud a=@ud] ^-(@ud ?:(=(i n) a $(i +(i), a +(+(a))))))
=bpick |=(t=@ud ^-(@ud ?:(=(t 0) 11 ?:(=(t 1) 3 ?:(=(t 2) 17 ?:(=(t 3) 5 ?:(=(t 4) 31 ?:(=(t 5) 7 ?:(=(t 6) 19 ?:(=(t 7) 2 ?:(=(t 8) 29 ?:(=(t 9) 13 ?:(=(t 10) 23 ?:(=(t 11) 37 ?:(=(t 12) 41 ?:(=(t 13) 43 ?:(=(t 14) 47 ?:(=(t 15) 53 0))))))))))))))))))
=bdispatch |=([n=@ud j=@ud a=@ud] ^-(@ud ?:(=(j n) a $(j +(j), a (add a (bpick (mod j 16)))))))
=bfold |=([l=(list @ud) a=@ud] ^-(@ud ?~(l a $(l t.l, a (add a i.l)))))
=bbuild |=([i=@ud l=(list @ud)] ^-((list @ud) ?:(=(i 0) l $(i (dec i), l [i l]))))
=bsum |=([i=@ud a=@ud] ^-(@ud ?:(=(i 0) a $(i (dec i), a (add a i)))))
=bmap |=([l=(list @ud) k=@ud] ^-((list @ud) ?~(l ~ [(add i.l k) $(l t.l)])))
=bfmap |=([l=(list @ud) k=@ud a=@ud] ^-(@ud ?~(l a $(l t.l, a (add a (add i.l k))))))
=blist (bbuild 120.000 ~)
=bchunk |=([lim=@ud i=@ud a=@ud] ^-(@ud ?:(=(i lim) a $(i +(+(+(+(+(+(+(+(i)))))))), a +(+(+(+(+(+(+(+(+(+(+(+(+(+(+(+(a))))))))))))))))))))
=bwide |=([n=@ud a=@ud] =/(cut=@ud (mul 8 (div n 8)) (bcount n cut (bchunk cut 0 a))))
=btchunk |=([lim=@ud i=@ud a=@ud] ^-(@ud ?:(=(i lim) a $(i +(+(+(+(i)))), a (add (add (add (add a (bpick (mod i 16))) (bpick (mod +(i) 16))) (bpick (mod +(+(i)) 16))) (bpick (mod +(+(+(i))) 16)))))))
=btwide |=([n=@ud a=@ud] =/(cut=@ud (mul 4 (div n 4)) (bdispatch n cut (btchunk cut 0 a))))
=btlen |=([l=(list @ud) a=@ud] ^-(@ud ?~(l a $(l t.l, a +(a)))))

~>(%bout (bcount 2.000.000 0 21))
~>(%bout (bdispatch 1.000.000 0 21))
~>(%bout (bfold (bbuild 250.000 ~) 21))
~>(%bout (bsum 250.000 21))
~>(%bout (bfold (bmap blist 4) 1))
~>(%bout (bfmap blist 4 1))
~>(%bout (bcount 2.000.003 0 20))
~>(%bout (bwide 2.000.003 20))
~>(%bout (bdispatch 1.000.003 0 20))
~>(%bout (btwide 1.000.003 20))
~>(%bout (btlen blist 21))
