=wseq (gulf 100 20.099)
=wpairs (turn wseq |=(i=@ [i +(i)]))
=wdups (turn wseq |=(i=@ [(mod i 257) i]))
=wmap (malt wpairs)
=wcmap (malt (turn wpairs |=(p=[@ @] [p 42])))
=wsmap (malt (scag 256 wpairs))
=wtiny (scag 8 wpairs)
=wrepeat (reap 20.000 (snag 0 wpairs))
?>(=(20.000 (lent wpairs)) 777)

^-  @ux  (shax (jam ~>(%bout (silt wseq))))
^-  @ux  (shax (jam ~>(%bout (malt wpairs))))
^-  @ux  (shax (jam ~>(%bout (malt wdups))))
^-  @ux  (shax (jam ~>(%bout ~(key by wmap))))
^-  @ux  (shax (jam ~>(%bout ~(key by wcmap))))
^-  @ux  (shax (jam ~>(%bout ~(key by wsmap))))
^-  @ux  (shax (jam ~>(%bout (malt wtiny))))
^-  @ux  (shax (jam ~>(%bout (malt wrepeat))))

=wseq (gulf 100 120.099)
=ws (scag 256 wseq)
=wpairs (turn wseq |=(i=@ [i +(i)]))
?>(=(120.000 (lent wpairs)) 777)

?>(=(0 =/(b (flop (flop wseq)) ~>(%bout =(wseq b)))) 782)
?>(=(1 =/(b (weld wseq ~[5]) ~>(%bout =(wseq b)))) 782)
?>(=(0 =/(b (turn wseq |=(i=@ [i +(i)])) ~>(%bout =(wpairs b)))) 782)
?>(=(0 =/(b (flop (flop ws)) ~>(%bout =(ws b)))) 782)
