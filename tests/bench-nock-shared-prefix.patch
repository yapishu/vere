+#ifdef U3_PROJECTION_PROBE
+static uint64_t axis_reads, axis_steps, axis_pairs[2], axis_common[2], axis_shared[2];
+
+void
+u3n_axis_pair_report(const char* where)
+{
+  fprintf(stderr, "axes %s reads=%" PRIu64 " steps=%" PRIu64
+          " swap_pairs=%" PRIu64 " swap_common=%" PRIu64 " swap_steps=%" PRIu64
+          " branch_pairs=%" PRIu64 " branch_common=%" PRIu64 " branch_steps=%" PRIu64 "\n",
+          where, axis_reads, axis_steps, axis_pairs[0], axis_common[0], axis_shared[0],
+          axis_pairs[1], axis_common[1], axis_shared[1]);
+}
+
+static inline void
+axis_read(u3_noun axis)
+{
+  if ( axis && axis <= 65535 ) {
+    ++axis_reads;
+    axis_steps += u3x_dep((c3_w)axis);
+  }
+}
+
+static void
+axis_pair(u3_noun first, const c3_y* pc, unsigned branch)
+{
+  if ( !first || first > 65535 ) return;
+  c3_w second;
+  switch ( *pc ) {
+    case FABK: case FABL: second = pc[1]; break;
+    case FASK: case FASL: second = pc[1] | (pc[2] << 8); break;
+    default: return;
+  }
+  if ( !second ) return;
+  unsigned a = u3x_dep((c3_w)first), b = u3x_dep(second);
+  unsigned depth = a < b ? a : b;
+  unsigned diff = (first >> (a-depth)) ^ (second >> (b-depth));
+  unsigned shared = depth - (diff ? 32u - __builtin_clz(diff) : 0);
+  ++axis_pairs[branch];
+  axis_common[branch] += !!shared;
+  axis_shared[branch] += shared;
+}
+#endif
