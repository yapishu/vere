=g-right (gulf 80.002 90.001)
=g-whole (gulf 1 90.001)
=g-num (gulf 1 80.001)
=g-pairs (turn g-num |=(v=@ [v +(v)]))
=g-record (weld (scag 41 g-pairs) [[42 0] (slag 42 g-pairs)])
=g-skip (weld (gulf 1 41) (gulf 43 80.001))
=g-mid (weld (gulf 1 39.999) [0 (gulf 40.001 80.001)])
=g-end (weld (gulf 1 79.999) [0 (slag 80.000 g-num)])
=g-odd (turn (gulf 1 40.001) |=(v=@ (dec (mul 2 v))))
=g-inc (gulf 2 80.002)
=g-two (gulf 3 80.003)
=g-shift 2
?>(=(80.001 (lent g-end)) 777)

?>(=(~>(%bout (turn g-pairs |=(p=[a=@ b=@] ?:(=(b.p 43) [a.p 0] p)))) g-record) 782)
?>(=(~>(%bout (turn g-pairs |=([a=@ b=@] b))) g-inc) 782)
?>(=(~>(%bout (weld g-num g-right)) g-whole) 782)
?>(=(~>(%bout (turn g-num |=(a=@ a))) g-num) 782)
?>(=(~>(%bout (turn g-num |=(a=@ ?:(=(a 1) 0 a)))) [0 (slag 1 g-num)]) 782)
?>(=(~>(%bout (turn g-num |=(a=@ ?:(=(a 40.000) 0 a)))) g-mid) 782)
?>(=(~>(%bout (turn g-num |=(a=@ ?:(=(a 80.000) 0 a)))) g-end) 782)
?>(=(~>(%bout (skip g-num |=(a=@ =(a 42)))) g-skip) 782)
?>(=(~>(%bout (skim g-num |=(a=@ %.y))) g-num) 782)
?>(=(~>(%bout (murn g-num |=(a=@ ?:(=(a 1) ~ [~ a])))) (slag 1 g-num)) 782)
?>(=(~>(%bout (turn g-num |=(a=@ +(a)))) g-inc) 782)
?>(=(~>(%bout (skim g-num |=(a=@ =(a 42)))) ~[42]) 782)
?>(=(~>(%bout (skip g-num |=(a=@ =(0 (end 0 a))))) g-odd) 782)
?>(=(~>(%bout (turn g-num |=(a=@ (add a g-shift)))) g-two) 782)

=g-rows `(list [@tas @])`[[%header 0] (turn (gulf 1 159.999) |=(n=@ [%data n]))]
=g-update |=(p=[tag=@tas val=@] ?:(=(tag.p %header) [tag.p +(val.p)] p))
=g-rev-a (turn g-rows g-update)
=g-rev-b (turn g-rev-a g-update)
=g-rev-c (turn g-rev-b g-update)
=g-rev-d (turn g-rev-c g-update)
=g-rev-e (turn g-rev-d g-update)
=g-rev-f (turn g-rev-e g-update)
=g-rev-g (turn g-rev-f g-update)
=g-rev-h (turn g-rev-g g-update)
=g-rev-i (turn g-rev-h g-update)
=g-rev-j (turn g-rev-i g-update)
=g-rev-k (turn g-rev-j g-update)
=g-rev-l (turn g-rev-k g-update)
=g-rev-m (turn g-rev-l g-update)
=g-rev-n (turn g-rev-m g-update)
=g-rev-o (turn g-rev-n g-update)
=g-rev-p (turn g-rev-o g-update)
?>(=(~[g-rev-a g-rev-b g-rev-c g-rev-d g-rev-e g-rev-f g-rev-g g-rev-h g-rev-i g-rev-j g-rev-k g-rev-l g-rev-m g-rev-n g-rev-o g-rev-p] ~[[[%header 1] (slag 1 g-rows)] [[%header 2] (slag 1 g-rows)] [[%header 3] (slag 1 g-rows)] [[%header 4] (slag 1 g-rows)] [[%header 5] (slag 1 g-rows)] [[%header 6] (slag 1 g-rows)] [[%header 7] (slag 1 g-rows)] [[%header 8] (slag 1 g-rows)] [[%header 9] (slag 1 g-rows)] [[%header 10] (slag 1 g-rows)] [[%header 11] (slag 1 g-rows)] [[%header 12] (slag 1 g-rows)] [[%header 13] (slag 1 g-rows)] [[%header 14] (slag 1 g-rows)] [[%header 15] (slag 1 g-rows)] [[%header 16] (slag 1 g-rows)]]) 780)
