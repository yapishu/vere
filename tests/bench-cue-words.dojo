=wnums (gulf 1 80.000)
=wpairs (turn wnums |=(i=@ [i +(i)]))
=wshare (reap 80.000 [55 66 77])
=wsmall (gulf 1 20.000)
=wblob (lsh [3 1.000.000] 1)

=wpack (jam [500 wnums])
?>(=([500 wnums] ~>(%bout (cue wpack))) 782)
=wpack (jam [500 wpairs])
?>(=([500 wpairs] ~>(%bout (cue wpack))) 782)
=wpack (jam [500 wshare])
?>(=([500 wshare] ~>(%bout (cue wpack))) 782)
=wpack (turn wsmall |=(v=@ (jam [500 v])))
?>(=((turn wsmall |=(v=@ [500 v])) ~>(%bout (turn wpack cue))) 782)
=wpack (jam [500 wblob])
?>(=([500 wblob] ~>(%bout (cue wpack))) 782)
