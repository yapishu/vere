=mpick |=([p=* q=* r=* s=* t=* u=* v=* z=*] ^-(@ud ?:(=(v %void) 11 ?:(=(v %noun) 13 ?:(?=([%atom *] v) 17 ?:(?=([%cell *] v) 19 ?:(?=([%core *] v) 23 ?:(?=([%face *] v) 29 ?:(?=([%fork *] v) 31 ?:(?=([%hold *] v) 37 41))))))))))
=mscore |=([l=(list *) a=@ud] ^-(@ud ?~(l a $(l t.l, a (add a (mpick 0 0 0 0 0 0 i.l 0))))))
=mrepeat |=([n=@ud l=(list *)] ^-((list *) ?:(=(n 0) l $(n (dec n), l (weld l l)))))
=mmix (mrepeat 15 ~[%void %noun [%atom 1] [%cell 2] [%core 3] [%face 4] [%fork 5] [%hold 6] %other [%other 7]])
=matoms (mrepeat 16 ~[%void %noun %other %unknown])
=mcells (mrepeat 15 ~[[%atom 1] [%cell 2] [%core 3] [%face 4] [%fork 5] [%hold 6] [%other 7] [[1 2] 8]])
=mfirst (mrepeat 18 ~[%void])
=mcount |=([n=@ud i=@ud a=@ud] ^-(@ud ?:(=(i n) a $(i +(i), a +(+(a))))))

~>(%bout (mscore mmix 41))
~>(%bout (mscore matoms 41))
~>(%bout (mscore mcells 41))
~>(%bout (mscore mfirst 41))
~>(%bout (mcount 2.000.000 0 41))
