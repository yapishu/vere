+// The factory and sample are evaluated by separate calls. Changing the
+// receiver at one call site exercises both the field and whole-core entries.
+static void
+_gate_returns(void)
+{
+  u3_noun arms[] = {
+    _slot(6), _slot(7), _slot(2), _slot(1), _slot(3),
+    u3nc(_slot(6), _slot(15)),
+    u3nq(6, u3nc(3, _slot(6)), _slot(12), _slot(7)),
+    u3nq(6, u3nt(5, _slot(6), _lit(0)), _slot(1), _slot(6)),
+    _slot(60)
+  };
+  for ( unsigned mode = 0; mode < 10; mode++ ) {
+    u3_noun make = u3nt(9, 2, _slot(2));
+    u3_noun sample;
+    switch ( mode % 5 ) {
+      case 0: sample = _slot(3); break;
+      case 1: sample = u3nt(9, 2, _slot(3)); break;
+      case 2: sample = u3nc(_slot(3), _slot(7)); break;
+      case 3: sample = u3nt(5, _slot(2), _slot(3)); break;
+      default: sample = u3nc(u3nt(5, _slot(2), _slot(3)), _slot(3)); break;
+    }
+    u3_noun call = u3nt(9, 2, u3nt(10, u3nc(6, sample), make));
+    if ( mode >= 5 ) call = u3nc(call, _slot(3));
+    for ( unsigned arm = 0; arm < sizeof(arms)/sizeof(*arms); arm++ ) {
+      u3_noun factory = u3nt(8, _lit(17), u3nc(_lit(u3k(arms[arm])), _slot(1)));
+      for ( unsigned j = 0; j < 4; j++ ) {
+        u3_noun value = j & 1 ? u3nc(70 + j, 19) : j;
+        if ( mode % 5 == 1 ) value = u3nc(_slot(j == 3 ? 0 : 3), value);
+        u3_noun producer = j & 2 ? u3nt(7, _slot(3), u3k(factory)) : u3k(factory);
+        u3_noun bus = u3nc(u3nc(producer, u3nc(9, 11)), value);
+        _check(bus, u3k(call));
+      }
+      u3z(factory);
+    }
+    u3z(call);
+  }
+  for ( unsigned i = 0; i < sizeof(arms)/sizeof(*arms); i++ ) u3z(arms[i]);
+}
