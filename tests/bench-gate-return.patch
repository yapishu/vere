+#ifdef U3_GATE_RETURN_NATIVE
+// These wrappers only project their operands before calling their noun
+// primitive. The primitive retains its inputs. On an unsupported sample
+// the ordinary wrapper supplies the jet's usual type checks and bail.
+u3_weak
+u3j_gate_native(const u3j_site* site, u3_noun battery, u3_noun sample, u3_noun context)
+{
+  u3j_harm* harm = site->ham_u;
+  if ( site->loc == u3_none || site->jet_o != c3y || site->axe != 2 ||
+       !harm || harm->liv != c3y || harm->ice != c3y ||
+       c3n == u3j_gate_parent(site->fin_p, battery, context) ) return u3_none;
+  u3_noun (*wrapper)(u3_noun) = harm->fun_f;
+  if ( wrapper == u3wdi_uni || wrapper == u3wdi_put || wrapper == u3wdi_has ) {
+    u3_weak set = u3r_at(6, context);
+    if ( set == u3_none ) return u3_none;
+    if ( wrapper == u3wdi_uni ) return u3qdi_uni(set, sample);
+    if ( wrapper == u3wdi_put ) return u3qdi_put(set, sample);
+    return u3qdi_has(set, sample);
+  }
+  if ( wrapper == u3wb_lent ) return u3qb_lent(sample);
+  if ( c3y == u3ud(sample) ) {
+    if ( wrapper == u3wc_cap ) return u3qc_cap(sample);
+    if ( wrapper == u3wc_mas ) return u3qc_mas(sample);
+  }
+  else {
+    u3_noun a = u3h(sample), b = u3t(sample);
+    if ( wrapper == u3wb_weld ) return u3qb_weld(a, b);
+    if ( c3y == u3ud(a) && c3y == u3ud(b) ) {
+      if ( wrapper == u3wc_peg ) return u3qc_peg(a, b);
+      if ( wrapper == u3wa_gth ) return u3qa_gth(a, b);
+    }
+  }
+  return u3_none;
+}
+#endif
