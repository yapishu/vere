diff --git a/pkg/noun/nock_gate_return.inc b/pkg/noun/nock_gate_return.inc
new file mode 100644
index 0000000000000000000000000000000000000000..0052acd903b967f4e737280729f7675b051b8361
--- /dev/null
+++ b/pkg/noun/nock_gate_return.inc
@@ -0,0 +1,157 @@
+// A factory returns [literal-battery [literal-sample subject]]. Its bytecode
+// already contains the literal and registration indices. Keep their offsets.
+static c3_y
+_n_gate_factory(const u3n_prog* prog)
+{
+  const c3_y* ops = prog->byc_u.ops_y;
+  size_t length = prog->byc_u.len_w;
+  if ( ops[0] < LIT0 || ops[0] > LISK ) return 0;
+  size_t field = 2 + _n_arg(ops[0]);
+  if ( field + 4 >= length || ops[field-1] != SNOL ||
+       (ops[field] != LIBK && ops[field] != LISK) ) return 0;
+  size_t end = field + 1 + _n_arg(ops[field]);
+  if ( end + 2 >= length || ops[end] != SWAP || ops[end+1] != AULT ) return 0;
+  end += 2;
+  if ( end + 1 == length && ops[end] == HALT ) return field;
+  if ( ops[end] != LIBK && ops[end] != LISK ) return 0;
+  end += 1 + _n_arg(ops[end]);
+  if ( end + 2 >= length || ops[end] != SWAP ||
+       (ops[end+1] != BALT && ops[end+1] != SALT) ) return 0;
+  end += 2 + _n_arg(ops[end+1]);
+  return end + 1 == length && ops[end] == HALT ? 128 | field : 0;
+}
+
+// After SWAP the gate stays in one stack slot while the caller evaluates
+// its sample. A head kick can consume another operand and return to this
+// continuation. An instruction which might touch the gate ends the proof.
+static c3_y
+_n_gate_continuation(const c3_y* start, const c3_y* end)
+{
+  if ( start == end || *start != SWAP ) return 0;
+  unsigned depth = 1;
+  for ( const c3_y* pc = start + 1; pc < end && pc - start <= 255;
+        pc += 1 + _n_arg(*pc) ) {
+    c3_y op = *pc;
+    if ( (op == MUSM && depth == 1) || (op == KUSM && depth == 2) )
+      return pc + 1 < end && pc[1] >= KICB && pc[1] <= TICS ? pc - start : 0;
+    if ( op == SWAP ) {
+      if ( depth < 2 ) return 0;
+    }
+    else if ( op == COPY || op == HEAD || op == TAIL ||
+              (op >= FABK && op <= FISK) || (op >= LIT0 && op <= LISK) ) depth++;
+    else if ( op == HELD || op == TALL || (op >= FABL && op <= FISL) ||
+              (op >= LIL0 && op <= LISL) || (op >= DEEP && op <= SANS) ||
+              op == KICB || op == KICS ) continue;
+    else if ( op == TOSS || op == SNOL || op == AULT || op == SALM ||
+              op == MUSM || op == MUTH || op == MUTT ) {
+      if ( depth < 2 ) return 0;
+      depth--;
+    }
+    else if ( op == AUTO || op == SAME || op == KUSM || op == KUTH || op == KUTT ) {
+      if ( depth < 3 ) return 0;
+      depth--;
+    }
+    else if ( op != SNOC || depth < 2 ) return 0;
+  }
+  return 0;
+}
+
+static void
+_n_gate_prepare(u3n_prog* prog)
+{
+  prog->byc_u.factory_y = _n_gate_factory(prog);
+#ifdef U3_GATE_FACTORY_ONLY
+  // Measure direct factory execution with every sample edit on the ordinary path.
+  for ( c3_w i = 0; i < prog->cal_u.len_w; ++i ) prog->cal_u.sit_u[i].span_y = 0;
+  return;
+#endif
+  const c3_y* pc = prog->byc_u.ops_y;
+  const c3_y* end = pc + prog->byc_u.len_w;
+  while ( pc < end ) {
+    const c3_y* next = pc + 1 + _n_arg(*pc);
+    if ( *pc == KICB || *pc == KICS ) {
+      prog->cal_u.sit_u[_n_field_arg(pc)].span_y = _n_gate_continuation(next, end);
+    }
+    else if ( *pc == TICB || *pc == TICS ) {
+      prog->cal_u.sit_u[_n_field_arg(pc)].span_y = 0;
+    }
+    pc = next;
+  }
+}
+
+static const u3_noun*
+_n_gate_literal(const u3n_prog* factory, u3_noun context)
+{
+  c3_y kind = factory->byc_u.factory_y;
+  const c3_y* literal = factory->byc_u.ops_y + (kind & 127);
+  const u3_noun* battery = &factory->lit_u.non[_n_field_arg(literal)];
+  if ( kind & 128 ) {
+    const c3_y* clue = literal + 3 + _n_arg(*literal);
+    const c3_y* reg = clue + 2 + _n_arg(*clue);
+    u3j_rite* rite = &factory->reg_u.rit_u[_n_field_arg(reg)];
+    if ( rite->clu != factory->lit_u.non[_n_field_arg(clue)] ||
+         c3n == u3j_gate_parent(rite->fin_p, *battery, context) ) return NULL;
+  }
+  return battery;
+}
+
+#ifdef U3_GATE_RETURN_FUSE
+// One projection supplies the replacement sample. Its reference is acquired
+// before the caller releases the subject, including when the two alias.
+static u3_weak
+_n_gate_sample(const u3n_prog* caller, const c3_y* pc, u3_noun subject)
+{
+  c3_w arg = _n_field_arg(pc);
+  switch ( *pc ) {
+    case HEAD: case HELD: return u3r_at(2, subject);
+    case TAIL: case TALL: return u3r_at(3, subject);
+    case FABK: case FABL: case FASK: case FASL: return arg ? u3r_at(arg, subject) : u3_none;
+    case FIBK: case FIBL: case FISK: case FISL: {
+      u3_noun axis = caller->lit_u.non[arg];
+      return axis ? u3r_at(axis, subject) : u3_none;
+    }
+    case LIT0: case LIL0: return 0;
+    case LIT1: case LIL1: return 1;
+    case LITB: case LITS: case LILB: case LILS: return arg;
+    case LIBK: case LISK: case LIBL: case LISL: return caller->lit_u.non[arg];
+    case COPY: return subject;
+    default: return u3_none;
+  }
+}
+
+static u3_noun
+_n_gate_make(const u3n_prog* factory, u3_noun context)
+{
+  const c3_y* code = factory->byc_u.ops_y;
+  c3_y kind = factory->byc_u.factory_y;
+  const c3_y* literal = code + (kind & 127);
+  u3_noun sample = _n_gate_sample(factory, code, context);
+  u3_noun gate = u3nt(u3k(factory->lit_u.non[_n_field_arg(literal)]), u3k(sample), context);
+  if ( kind & 128 ) {
+    const c3_y* clue = literal + 3 + _n_arg(*literal);
+    const c3_y* reg = clue + 2 + _n_arg(*clue);
+    u3t_off(noc_o);
+    u3j_rite_mine_keep(&factory->reg_u.rit_u[_n_field_arg(reg)],
+                       factory->lit_u.non[_n_field_arg(clue)], gate);
+    u3t_on(noc_o);
+  }
+  return gate;
+}
+#endif
+
+#ifdef U3_GATE_RETURN_STATS
+static uint64_t gate_deferred, gate_entered, gate_cold, gate_guard;
+static uint64_t gate_whole, gate_native, gate_suffix;
+uint64_t u3n_gate_crossed;
+
+void
+u3n_gate_return_report(const char* phase)
+{
+  fprintf(stderr, "gate %s deferred=%" PRIu64 " entered=%" PRIu64 " cold=%" PRIu64
+          " guard=%" PRIu64 " whole=%" PRIu64 " native=%" PRIu64 " crossed=%" PRIu64 " suffix=%" PRIu64 "\n",
+          phase, gate_deferred, gate_entered, gate_cold, gate_guard, gate_whole, gate_native, u3n_gate_crossed, gate_suffix);
+}
+#define GATE_COUNT(counter) (++counter)
+#else
+#define GATE_COUNT(counter) ((void)0)
+#endif
