+// Check a registered core whose first parent lies in the context at axis 7.
+c3_o
+u3j_gate_parent(u3p(u3j_fink) fin_p, u3_noun battery, u3_noun context)
+{
+  if ( !fin_p ) return c3n;
+  const u3j_fink* fin = u3to(u3j_fink, fin_p);
+  if ( !fin->len_w || fin->fis_u[0].pax != 7 ||
+       fin->fis_u[0].bat != battery ) return c3n;
+  for ( c3_w i = 1; i < fin->len_w; i++ ) {
+    if ( c3n == u3du(context) || c3n == u3r_sing(fin->fis_u[i].bat, u3h(context)) )
+      return c3n;
+    context = u3r_at(fin->fis_u[i].pax, context);
